# URL base del WebSocket (solo protocolo + host + puerto; el path /ws/{user_id} se construye en código)
# Desarrollo: ws://localhost:8000
# Producción: wss://api.ejemplo.jne.gob.pe
VITE_WEBSOCKET_URL=ws://localhost:8000

# Ambiente de la aplicacion
# DEV = Desarrollo (activa proxy para HTTPS)
# PRD = Producción (usa URL directa del backend)
VITE_APP_ENV=DEV

# ===========================================
# Variables de infraestructura (Docker / nginx)
# Solo se usan para generar nginx.conf antes del build.
# No son accesibles en el navegador.
# ===========================================

# Puerto donde nginx escuchará dentro del contenedor
PUBLIC_PORT=

# Dominio para nginx server_name (usar _ para aceptar cualquier host)
CUSTOM_DOMAIN=_

# ===========================================
# Variables públicas VITE_* (inyectadas en runtime)
# Se exponen en window.env y son visibles en DevTools.
# No guardes secretos del servidor aquí.
# ===========================================

# URL base del WebSocket del backend
# Desarrollo: ws://localhost:5010/api/v1
# Producción: wss://chatbot.jne.gob.pe/api/v1
VITE_WEBSOCKET_URL=

# URL base HTTP del backend para el embed script
# Desarrollo: http://localhost:5010/api/v1
# Producción: https://chatbot.jne.gob.pe/api/v1
VITE_EMBED_API_BASE_URL=

# Ambiente de la aplicación (DEV | PRD)
VITE_APP_ENV=PRD

# Nombre visible del bot/chat en el encabezado
VITE_CHAT_NAME=Asistente
